{
    "manifest_version": 3,
    "name": "Group Snooze",
    "version": "1.0.0",
    "description": "Discards every tab in a tab group when you collapse it, then restores media position and form input when the tabs come back.",
    "minimum_chrome_version": "116",
    "permissions": [
        "tabs",
        "tabGroups",
        "scripting",
        "storage",
        "contextMenus"
    ],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "src/background/service-worker.ts",
        "type": "module"
    },
    "options_ui": {
        "page": "src/options/options.html",
        "open_in_tab": true
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
